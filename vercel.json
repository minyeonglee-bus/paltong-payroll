{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] },
    { "source": "/(.*)\\.(js|html|css)", "headers": [
      { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
    ] },
    { "source": "/", "headers": [
      { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
    ] }
  ]
}
